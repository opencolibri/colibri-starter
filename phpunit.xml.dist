<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="core">
            <directory>src/Core/tests</directory>
        </testsuite>
        <testsuite name="dataset-builder">
            <directory>src/DatasetBuilder/tests</directory>
        </testsuite>
        <testsuite name="datasets">
            <directory>src/Datasets/tests</directory>
        </testsuite>
        <testsuite name="dev-kit">
            <directory>src/DevKit/tests</directory>
        </testsuite>
        <testsuite name="dev-kit-bundle">
            <directory>src/DevKitBundle/tests</directory>
        </testsuite>
        <testsuite name="fixtures">
            <directory>src/Fixtures/tests</directory>
        </testsuite>
        <testsuite name="menu">
            <directory>src/Menu/tests</directory>
        </testsuite>
        <testsuite name="plugins">
            <directory>src/Plugins/tests</directory>
        </testsuite>
        <testsuite name="sales-kit">
            <directory>src/SalesKit/tests</directory>
        </testsuite>
        <testsuite name="sales-kit-bundle">
            <directory>src/SalesKitBundle/tests</directory>
        </testsuite>
        <testsuite name="themes">
            <directory>src/Themes/tests</directory>
        </testsuite>
        <testsuite name="upsun">
            <directory>src/Upsun/tests</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src/*/src</directory>
        </include>
    </source>
</phpunit>

{
    "name": "opencolibri/starter",
    "description": "Colibri Starter: Castor tooling to bootstrap and customize Sylius applications (monorepo of all opencolibri/starter-* packages)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/opencolibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "castor-php/docker": "^0.10",
        "nikic/php-parser": "^5.0",
        "symfony/ai-ollama-platform": "^0.12.0",
        "symfony/ai-open-router-platform": "^0.12.0",
        "symfony/ai-platform": "^0.12.0",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/filesystem": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/process": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "require-dev": {
        "jolicode/castor": "^1.6",
        "knplabs/knp-menu-bundle": "^3.0",
        "pagerfanta/core": "^4.6",
        "phpunit/phpunit": "^13.2",
        "sylius/admin-ui": "^0.14",
        "sylius/grid-bundle": "^1.13",
        "sylius/shadcn-admin-ui": "^0.14@dev",
        "sylius/twig-hooks": "^0.14",
        "sylius/ui-translations": "^0.14",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/css-selector": "^7.4|^8.0",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/ux-live-component": "^2.30 || ^3.5",
        "symfony/validator": "^7.4"
    },
    "replace": {
        "opencolibri/starter-core": "self.version",
        "opencolibri/starter-dataset-builder": "self.version",
        "opencolibri/starter-datasets": "self.version",
        "opencolibri/starter-fixtures": "self.version",
        "opencolibri/starter-import": "self.version",
        "opencolibri/starter-menu": "self.version",
        "opencolibri/starter-plugins": "self.version",
        "opencolibri/starter-sales-kit": "self.version",
        "opencolibri/starter-themes": "self.version",
        "opencolibri/starter-upsun": "self.version"
    },
    "suggest": {
        "jolicode/castor-api": "Expose the tasks over HTTP"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\Core\\": "src/Core/src/",
            "OpenColibri\\Starter\\DatasetBuilder\\": "src/DatasetBuilder/src/",
            "OpenColibri\\Starter\\Datasets\\": "src/Datasets/src/",
            "OpenColibri\\Starter\\Fixtures\\": "src/Fixtures/src/",
            "OpenColibri\\Starter\\Import\\": "src/Import/src/",
            "OpenColibri\\Starter\\Menu\\": "src/Menu/src/",
            "OpenColibri\\Starter\\Plugins\\": "src/Plugins/src/",
            "OpenColibri\\Starter\\SalesKit\\": "src/SalesKit/src/",
            "OpenColibri\\Starter\\Themes\\": "src/Themes/src/",
            "OpenColibri\\Starter\\Upsun\\": "src/Upsun/src/"
        },
        "files": [
            "src/Core/src/Installer/functions.php",
            "src/DatasetBuilder/src/constants.php",
            "src/DatasetBuilder/src/paths.php",
            "src/DatasetBuilder/src/url.php",
            "src/DatasetBuilder/src/name.php",
            "src/DatasetBuilder/src/catalog.php",
            "src/DatasetBuilder/src/Images/download.php",
            "src/DatasetBuilder/src/Ai/platform.php",
            "src/DatasetBuilder/src/Ai/enrichment.php",
            "src/DatasetBuilder/src/Ai/grouping.php",
            "src/DatasetBuilder/src/Ai/curation.php",
            "src/DatasetBuilder/src/Ai/catalog.php",
            "src/DatasetBuilder/src/Fetch/http.php",
            "src/DatasetBuilder/src/Fetch/sitemap.php",
            "src/DatasetBuilder/src/Fetch/fetch.php",
            "src/DatasetBuilder/src/functions.php",
            "src/Datasets/src/functions.php",
            "src/Fixtures/src/functions.php",
            "src/Import/src/constants.php",
            "src/Import/src/ImportContext.php",
            "src/Import/src/ImportBootstrap.php",
            "src/Import/src/bootstrap.php",
            "src/Import/src/functions.php",
            "src/Menu/src/functions.php",
            "src/Plugins/src/functions.php",
            "src/Themes/src/functions.php",
            "src/Upsun/src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\Core\\Tests\\": "src/Core/tests/",
            "OpenColibri\\Starter\\DatasetBuilder\\Tests\\": "src/DatasetBuilder/tests/",
            "OpenColibri\\Starter\\Datasets\\Tests\\": "src/Datasets/tests/",
            "OpenColibri\\Starter\\Fixtures\\Tests\\": "src/Fixtures/tests/",
            "OpenColibri\\Starter\\Import\\Tests\\": "src/Import/tests/",
            "OpenColibri\\Starter\\Menu\\Tests\\": "src/Menu/tests/",
            "OpenColibri\\Starter\\Plugins\\Tests\\": "src/Plugins/tests/",
            "OpenColibri\\Starter\\SalesKit\\Tests\\": "src/SalesKit/tests/",
            "OpenColibri\\Starter\\Themes\\Tests\\": "src/Themes/tests/",
            "OpenColibri\\Starter\\Upsun\\Tests\\": "src/Upsun/tests/",
            "OpenColibri\\Starter\\Tests\\": "tests/",
            "OpenColibri\\Starter\\Monorepo\\": ".castor/monorepo/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        },
        "monorepo": {
            "bundle-dependencies": [
                "knplabs/knp-menu-bundle",
                "pagerfanta/core",
                "sylius/admin-ui",
                "sylius/grid-bundle",
                "sylius/shadcn-admin-ui",
                "sylius/twig-hooks",
                "sylius/ui-translations",
                "symfony/form",
                "symfony/framework-bundle",
                "symfony/security-bundle",
                "symfony/ux-live-component",
                "symfony/validator"
            ]
        }
    }
}
